{
  "name": "qrcode-decode-ultra",
  "version": "1.1.0",
  "description": "Fast browser QR scanner core — native → jsQR zero-WASM fast path with an opt-in OpenCV WeChat tier, Web Worker by default.",
  "type": "module",
  "license": "MIT",
  "author": "Zoe Ying",
  "homepage": "https://github.com/zoexx/qrcode-decode-ultra",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zoexx/qrcode-decode-ultra.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/zoexx/qrcode-decode-ultra/issues"
  },
  "keywords": [
    "qr",
    "qrcode",
    "scanner",
    "barcode-detector",
    "jsqr",
    "wechat",
    "web-worker",
    "camera"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/scanner.worker.js"
  ],
  "files": [
    "dist",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/scanner.worker.d.ts",
      "import": "./dist/scanner.worker.js"
    },
    "./worker-runtime": {
      "types": "./dist/worker-runtime.d.ts",
      "import": "./dist/worker-runtime.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "gen:probe": "node scripts/gen-probe.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "jsqr": "1.4.0"
  },
  "devDependencies": {
    "qrcode": "1.5.4",
    "tsup": "8.5.1",
    "typescript": "^5.7.0",
    "vitest": "4.1.8"
  }
}
